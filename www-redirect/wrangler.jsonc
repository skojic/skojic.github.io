{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Redirects www.srdjankojic.com to srdjankojic.com (301). Deploy from this folder: npx wrangler deploy
  "name": "skojic-www",
  "main": "index.js",
  "compatibility_date": "2026-10-25",
  "routes": [
    { "pattern": "www.srdjankojic.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
